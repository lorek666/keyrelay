{
  "name": "tianshu-relay",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit --project tsconfig.build.json && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "node scripts/check-commands.mjs && node scripts/check-gateway-usage-flush.mjs && node scripts/check-i18n.mjs && node scripts/check-no-real-credentials.mjs && node scripts/check-charter-steps.mjs && node scripts/check-mut-isolation.mjs --self-test && node scripts/check-review-independence.mjs && node scripts/check-webview-creds-script.mjs && vitest run",
    "test:watch": "vitest",
    "gate": "node scripts/gate.mjs",
    "hooks:install": "node scripts/install-hooks.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.62.0",
    "@tauri-apps/api": "^2.1.1",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.13.3",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^30.1.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^5.0.4"
  }
}
