{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Tianshu Relay 主窗口的最小权限集：核心默认能力 + 本应用自有的全部命令",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-set-theme",
    "allow-list-sites",
    "allow-logout-site",
    "allow-app-info",
    "allow-detect-site",
    "allow-add-site",
    "allow-login-site",
    "allow-list-keys",
    "allow-create-key",
    "allow-site-balance",
    "allow-delivery-plan",
    "allow-grant-consent",
    "allow-revoke-consent",
    "allow-list-channel-bindings",
    "allow-list-consents",
    "allow-apply-delivery",
    "allow-rollback-delivery",
    "allow-list-deliveries",
    "allow-list-stored-keys",
    "allow-recent-events",
    "allow-drift-report",
    "allow-get-settings",
    "allow-update-settings",
    "allow-detect-system-proxy",
    "allow-refresh-all",
    "allow-audit-redaction",
    "allow-report-ui-ready",
    "allow-gateway-status",
    "allow-gateway-start",
    "allow-gateway-stop",
    "allow-export-bundle",
    "allow-prune-backups",
