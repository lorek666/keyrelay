    "allow-rotate-key",
    "allow-autostart-status",
    "allow-autostart-set",
    "allow-revoke-key",
    "allow-purge-keychain",
    "allow-detect-unmanaged-targets",
    "allow-detect-agents",
    "allow-vault-migration-status",
    "allow-vault-migration-retry",
    "allow-vault-migration-abandon",
    "allow-check-agent-updates",
    "allow-update-agent",
    "allow-list-key-models",
    "allow-suggest-key-name",
    "allow-unbind-agent",
    "allow-gateway-rotate-token",
    "allow-captcha-begin",
    "allow-captcha-complete",
    "allow-captcha-cancel",
    "allow-recent-gateway-usage",
    "allow-recent-usage-snapshots",
    "allow-recent-key-usage",
    "allow-usage-dashboard",
    "allow-list-alias-map",
    "allow-upsert-alias",
    "allow-delete-alias",
    "allow-probe-run",
    "allow-list-probe-runs",
    "allow-get-probe-run",
