{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "KeyRelay 主窗口的最小权限集：核心默认能力 + 本应用自有的全部命令",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "allow-list-sites",
    "allow-app-info",
    "allow-detect-site",
    "allow-add-site",
    "allow-login-site",
    "allow-list-keys",
    "allow-create-key",
    "allow-site-balance"
  ]
}
