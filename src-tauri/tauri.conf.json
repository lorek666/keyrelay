{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "天枢 Relay",
  "version": "0.1.0",
  "identifier": "com.tianshu.relay",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:3123",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "天枢 Relay · 中转站钥匙管家",
        "width": 1100,
        "height": 760,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese",
          "English"
        ],
        "installerIcon": "icons/icon.ico",
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDYxRjEzNzNENDA3QkZFQjUKUldTMS9udEFQVGZ4WWJlbG5NQXJnQno1ZVcrWHBTL1p5ZWNDTE1hYW1PTGx3T1Voc0w3cnZBa1EK",
      "endpoints": [
        "https://github.com/lorek666/keyrelay/releases/latest/download/latest.json"
      ]
    }
  },
  "mainBinaryName": "tianshu-relay"
}
